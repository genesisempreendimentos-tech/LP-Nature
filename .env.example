# =============================================================================
# Nature — Página de Vendas (API de leads + tracking unificado)
# Placeholders PRÓPRIOS deste projeto. Não reutilize .env de Feirão, Solar
# ou de outro empreendimento por analogia.
#
# Monorepo: apps/api lê este .env na raiz (e apps/api/.env).
# =============================================================================

# Postgres (Neon). Valor = só a URL postgresql://... (sem repetir DATABASE_URL=).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# Leads gravados sempre em public.leads (origem_tipo=site, origem_detalhe=lpa).

# CORS: origem do front Nature em dev / produção (nunca "*").
# Astro dev padrão = http://localhost:4321
ALLOWED_ORIGIN=http://localhost:4321

# Porta do processo Express (Astro faz proxy de /api → aqui no dev).
API_PORT=8787

# --- Tracking unificado (public.acessos_user) — só no servidor (apps/api) ---
# Nunca expor SERVICE_ROLE no front. Nunca versionar as chaves reais.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ID do site Nature na tabela de sites / contadores (obrigatório para gravar).
SITE_ID=11

# Em produção atrás de Nginx: true (usa última entrada de X-Forwarded-For).
# Em dev local: false ou omitido.
TRUST_PROXY=false

# Opcional — caminho absoluto do GeoLite2-City.mmdb (MaxMind). Sem arquivo = sem geo.
# MAXMIND_DB_PATH=/var/lib/maxmind/GeoLite2-City.mmdb
