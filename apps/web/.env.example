# Variáveis de build do front (apps/web). No VPS não há .env nesta pasta:
# passe no ambiente do comando `astro build` / `pnpm build`.
#
# Produção do widget: https://forms.genesisapps.com.br

# Só "1" liga o formulário global (padrão: desligado).
# PUBLIC_FORMULARIO_GLOBAL=

# Base HTTPS do widget Genesis Forms.
# PUBLIC_FORMS_WIDGET_BASE=

# formId público.
# PUBLIC_FORMS_ID=

# Só "1" = lead real (preview: false). Ausente ou outro valor = prévia.
# PUBLIC_FORMS_REAL=
