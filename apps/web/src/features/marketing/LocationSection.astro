---
import { LOCATION_POIS, NATURE_ADDRESS } from "../../data/locationPois"
import { siteData } from "../../data/siteData"
import LocationMapLazy from "../location/LocationMapLazy"
import SectionCta from "./SectionCta"

const headlineLines = siteData.location.headline.split("\n")
---

<section id="localizacao" class="location-section" data-marketing-reveal data-section="localizacao">
  <div class="shell">
    <div class="location-heading">
      <p class="eyebrow">02 / ALTO · TERESÓPOLIS</p>
      <h2 data-motion-heading>
        {headlineLines.map((line, i) => (
          <>
            {i > 0 && <br />}
            {line}
          </>
        ))}
      </h2>
      <div class="location-copy">
        <SectionCta client:load>Consultar unidades disponíveis no Alto</SectionCta>
      </div>
    </div>

    <div class="location-experience">
      <div class="location-map">
        <LocationMapLazy client:only="react" />
      </div>

      <aside class="location-panel">
        <div class="location-address">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="22"
            height="22"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.4"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M20 10c0 4.993-5.539 10.193-7.399 11.799a1 1 0 0 1-1.202 0C9.539 20.193 4 14.993 4 10a8 8 0 0 1 16 0"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
          <div>
            <p class="eyebrow">SEU NOVO ENDEREÇO</p>
            <strong set:html={NATURE_ADDRESS.full.replace("\n", "<br />")} />
          </div>
          <a href={NATURE_ADDRESS.mapLinkUrl} target="_blank" rel="noreferrer">
            <span>Explorar no mapa</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="19"
              height="19"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M7 7h10v10"></path>
              <path d="M7 17 17 7"></path>
            </svg>
          </a>
        </div>

        <div class="location-quotes">
          {
            siteData.location.quotes.map((quote) => (
              <blockquote>
                <p>{quote.title}</p>
                <q set:html={quote.text.replaceAll("\n", "<br />")} />
              </blockquote>
            ))
          }
        </div>
      </aside>
    </div>

    <div class="location-proximity" aria-label="O que há por perto">
      <div class="location-proximity-title">
        <span>POR PERTO</span>
        <p>Tudo que faz parte da sua rotina.</p>
        <small>Conveniência, natureza e serviços essenciais no entorno do Nature.</small>
      </div>
      {
        LOCATION_POIS.map((item, index) => (
          <article class="location-proximity-item" data-poi-source="locationPois">
            <span>0{index + 1}</span>
            <div>
              <h3>{item.label}</h3>
              <p>{item.text}</p>
              <small>{item.distance}</small>
            </div>
          </article>
        ))
      }
    </div>
  </div>
</section>
