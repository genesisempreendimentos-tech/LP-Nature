---
import { shellFooter, shellNav } from "../../data/shell"
import NatureLogo from "./NatureLogo"

const year = new Date().getFullYear()
const waHref = `https://wa.me/${shellFooter.whatsapp}?text=${encodeURIComponent(shellFooter.whatsappMessage)}`
---

<footer class="site-footer" id="site-footer">
  <div class="shell">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand-link" href="#inicio" aria-label="Nature Residencial — início">
          <NatureLogo light />
        </a>
        <p>{shellFooter.blurb}</p>
      </div>

      <nav class="footer-col" aria-label="Navegação do rodapé">
        <p class="footer-label">Navegação</p>
        <ul>
          {shellNav.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
          <li><a href="#contato">Contato</a></li>
        </ul>
      </nav>

      <div class="footer-col">
        <p class="footer-label">Atendimento</p>
        <ul class="footer-contact">
          <li>
            <span>Telefone</span>
            <a href={`tel:${shellFooter.phone.replace(/\D/g, "")}`}>{shellFooter.phone}</a>
          </li>
          <li>
            <span>WhatsApp</span>
            <a href={waHref} target="_blank" rel="noreferrer" data-wa-me="true">
              {shellFooter.whatsappLabel}
            </a>
          </li>
          <li>
            <span>Email</span>
            <a href={`mailto:${shellFooter.email}`}>{shellFooter.email}</a>
          </li>
          <li>
            <span>Endereço</span>
            <p>{shellFooter.address}</p>
          </li>
        </ul>
      </div>

      <div class="footer-col footer-social">
        <p class="footer-label">Social</p>
        <div class="footer-social-icons">
          <a
            href={shellFooter.instagram}
            target="_blank"
            rel="noreferrer"
            aria-label="Instagram da Gênesis Empreendimentos"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
            </svg>
          </a>
          <a
            href={shellFooter.facebook}
            target="_blank"
            rel="noreferrer"
            aria-label="Facebook da Gênesis Empreendimentos"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M14 9h3V6h-3c-1.7 0-3 1.3-3 3v2H9v3h2v7h3v-7h2.5l.5-3H14V9z"></path>
            </svg>
          </a>
          <a
            href={shellFooter.linkedin}
            target="_blank"
            rel="noreferrer"
            aria-label="LinkedIn da Gênesis Empreendimentos"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="currentColor">
              <path d="M6.5 9.5H3.7V20h2.8V9.5zM5.1 4A1.65 1.65 0 1 0 5.1 7.3 1.65 1.65 0 0 0 5.1 4zM20.3 20h-2.8v-5.6c0-1.5-.6-2.5-2-2.5-1.1 0-1.7.7-2 1.4-.1.3-.1.6-.1.9V20h-2.8s.1-8.8 0-9.7h2.8v1.6c.5-.8 1.5-1.9 3.6-1.9 2.5 0 4.3 1.6 4.3 5.1V20z"></path>
            </svg>
          </a>
        </div>
        <p class="footer-handle">{shellFooter.instagramHandle}</p>
        <a
          class="footer-social-cta"
          href={shellFooter.instagram}
          target="_blank"
          rel="noreferrer"
        >
          Seguir no Instagram
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="footer-bottom">
      <p>
        <a
          href={shellFooter.privacyHref}
          target="_blank"
          rel="noopener noreferrer"
        >
          Política de Privacidade
        </a>
        <span aria-hidden="true"> | </span>
        © {year} desenvolvido por Gênesis Empreendimentos
      </p>
      <p class="footer-disclaimer">{shellFooter.disclaimer}</p>
    </div>
  </div>
</footer>
