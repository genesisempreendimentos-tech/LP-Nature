---
/**
 * Página completa — ordem confirmada em src/App.tsx:
 * main(Hero→…→LeadForm) → Footer → FAB → LeadModal
 * Header sticky no shell (fora do Hero no Astro; no legado fica dentro do Hero).
 * appReady dispara ao fim do preloader (ou skip / reduced-motion).
 */
import HeaderIsland from "../features/shell/HeaderIsland"
import Footer from "../features/shell/Footer.astro"
import LeadModalIsland from "../features/lead/LeadModalIsland"
import LeadFabIsland from "../features/lead/LeadFabIsland"
import CookieConsentBanner from "../features/tracking/CookieConsentBanner"
import TrackingBootIsland from "../features/tracking/TrackingBootIsland"
import PreloaderIsland from "../features/shell/PreloaderIsland"
import Hero from "../features/hero/Hero.astro"
import HeroEntrance from "../features/hero/HeroEntrance"
import LifeMoment from "../features/marketing/LifeMoment.astro"
import Pillars from "../features/marketing/Pillars.astro"
import LocationSection from "../features/marketing/LocationSection.astro"
import FloorPlansIsland from "../features/marketing/FloorPlansIsland"
import AmenitiesIsland from "../features/marketing/AmenitiesIsland"
import Architecture from "../features/marketing/Architecture.astro"
import Trust from "../features/marketing/Trust.astro"
import ContactSection from "../features/marketing/ContactSection.astro"
import MarketingRevealBoot from "../features/marketing/MarketingRevealBoot"
import "../styles/islands.css"
import "../styles/shell.css"
import "../styles/hero.css"
import "../styles/marketing.css"
import "../styles/location.css"
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Nature Residencial | Alto, Teresópolis</title>
    <meta
      name="description"
      content="Nature Residencial no Alto, Teresópolis — apartamentos de 2 e 3 quartos em um novo padrão de vida."
    />
    <link rel="icon" href="/brand/nature-symbol.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/brand/nature-symbol.svg" />
    <!-- Meta Pixel: injetado só com consentimento 'aceito' (metaPixel.ts). -->
  </head>
  <body>
    {/* Shell estático até o island hidratar — evita flash sem overlay. */}
    <div
      id="nature-preloader-boot"
      class="nature-preloader nature-preloader--boot"
      aria-hidden="true"
    ></div>
    <PreloaderIsland client:load />
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <HeaderIsland client:only="react" />
    <HeroEntrance client:load />
    <MarketingRevealBoot client:load />
    <TrackingBootIsland client:load />

    <main id="conteudo">
      <Hero />
      <LifeMoment />
      <Pillars />
      <LocationSection />
      <FloorPlansIsland client:visible />
      <AmenitiesIsland client:visible />
      <Architecture />
      <Trust />
      <ContactSection />
    </main>

    <Footer />
    <LeadFabIsland client:only="react" />
    <LeadModalIsland client:only="react" />
    <CookieConsentBanner client:only="react" />

    <script>
      import {
        getTracking,
        iniciarFormularioGlobal,
      } from "../features/lead/formularioGlobal"
      iniciarFormularioGlobal()
      // Mantém o export do contrato getTracking no bundle (testes / diagnóstico).
      ;(window as Window & { __natureGetTracking?: typeof getTracking }).__natureGetTracking =
        getTracking
    </script>
  </body>
</html>

<style is:global>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 8px;
    z-index: 100;
    background: #fff;
    color: #1a1c1a;
    padding: 8px 12px;
  }
  .skip-link:focus {
    left: 8px;
  }
</style>
