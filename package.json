{
  "name": "nature-pagina-de-vendas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm run --parallel --filter @nature/web --filter @nature/api dev",
    "dev:web": "pnpm --filter @nature/web dev",
    "dev:api": "pnpm --filter @nature/api dev",
    "build": "pnpm --filter @nature/web build",
    "build:web": "pnpm --filter @nature/web build",
    "preview": "pnpm --filter @nature/web preview",
    "api:pm2:start": "pm2 start apps/api/ecosystem.config.cjs",
    "api:pm2:reload": "pm2 reload nature-api --update-env",
    "api:pm2:restart": "pm2 restart nature-api --update-env",
    "api:pm2:stop": "pm2 stop nature-api",
    "api:pm2:logs": "pm2 logs nature-api --lines 50",
    "api:pm2:save": "pm2 save",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.2.0",
    "pm2": "^6.0.8",
    "typescript": "^5.7.0"
  },
  "dependencies": {
    "playwright": "1.63.0"
  }
}
