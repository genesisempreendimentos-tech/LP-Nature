{
  "name": "nature-pagina-de-vendas",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "dev:api": "pnpm --filter @nature/api start",
    "dev:web": "npm run dev --workspace=@nature/web",
    "build:web": "npm run build --workspace=@nature/web",
    "api:pm2:start": "pm2 start apps/api/ecosystem.config.cjs",
    "api:pm2:reload": "pm2 reload nature-api --update-env",
    "api:pm2:restart": "pm2 restart nature-api --update-env",
    "api:pm2:stop": "pm2 stop nature-api",
    "api:pm2:logs": "pm2 logs nature-api --lines 50",
    "api:pm2:save": "pm2 save",
    "build": "vite build",
    "preview": "vite preview",
    "format": "oxfmt"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@nature/shared": "file:packages/shared",
    "@radix-ui/react-dialog": "^1.1.23",
    "@types/leaflet": "^1.9.22",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "gsap": "^3.15.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.43.0",
    "pg": "^8.13.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-imask": "^7.6.1",
    "react-leaflet": "^5.0.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "oxfmt": "^0.2.0",
    "pm2": "^6.0.8",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
