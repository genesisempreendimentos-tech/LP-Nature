{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "@nature/shared": ["./packages/shared/src/index.ts"],
      "@nature/shared/*": ["./packages/shared/src/*"]
    }
  }
}
